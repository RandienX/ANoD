[sub_resource type="GDScript" id="GDScript_f1ai2"]
resource_name = "helper"
script/source = "extends Node

func _ready() -> void:
	await get_tree().create_timer(0.05).timeout
	
	if \"hatcis_fought_1\" in get_tree().current_scene.done_things.keys():
		$party_taken.play(\"party_taken\")
		print(\"SUCCESS!!!\")
"


[sub_resource type="GDScript" id="GDScript_f1ai2"]
resource_name = "anim_helper"
script/source = "extends Node

func _ready() -> void:
	if Global.get_thing_done(\"Cave - Gates\", \"hatcis_cutscene_1\") == 1:
		$hatcis_anim.play(\"hatcis_anim\")
"


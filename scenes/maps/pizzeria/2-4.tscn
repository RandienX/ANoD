resource_name = "cupcake"
script/source = "extends TileMapLayer

func _process(_delta: float) -> void:
	if \"carl_start\" in get_tree().current_scene.completed_dialogues:
		$objects_top.set_cell(Vector2i(8,7), 1, Vector2i(8,5))
"


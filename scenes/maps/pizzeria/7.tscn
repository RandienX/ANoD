[sub_resource type="GDScript" id="GDScript_exps5"]
resource_name = "helper"
script/source = "extends CanvasLayer

func _ready() -> void:
	await get_tree().create_timer(0.1).timeout
	if \"Toilet\" in Global.enemies_killed.keys() and \"toilet_done\" not in get_tree().current_scene.done_things.keys():
		get_tree().current_scene.done_thing(\"toilet_done\", true)
		DialogueInitiator.start_dialogue(load(\"res://resources/dialogue/toilet_done.tres\"), false, true)
"


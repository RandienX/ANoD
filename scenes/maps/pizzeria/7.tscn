[sub_resource type="GDScript" id="GDScript_vqygh"]
resource_name = "open_door_if_bonnie"
script/source = "extends Area2D

func _on_body_entered(body: Node2D) -> void:
	if body.name not in [\"player\", \"PartyMemberBonnie\", \"PartyMemberChica\", \"PartyMemberFoxy\", \"PartyMemberGolden Freddy\"]: return
	
	await get_tree().create_timer(0.1).timeout
	for c in get_overlapping_bodies():
		if c.name in [\"PartyMemberBonnie\", \"PartyMemberChica\", \"PartyMemberFoxy\", \"PartyMemberGolden Freddy\"]: return
		
	$\"../../TileMap/objects\".set_cell(Vector2i(3, 9), 1, Vector2i(8, 10))
	Sfx2.stream = load(\"res://assets/sound/sfx/door_open.mp3\")
	Sfx2.play()

func _on_body_exited(body: Node2D) -> void:
	if body.name not in [\"player\", \"PartyMemberBonnie\", \"PartyMemberChica\", \"PartyMemberFoxy\", \"PartyMemberGolden Freddy\"]: return
	
	await get_tree().create_timer(0.1).timeout
	for c in get_overlapping_bodies():
		if c.name in [\"PartyMemberBonnie\", \"PartyMemberChica\", \"PartyMemberFoxy\", \"PartyMemberGolden Freddy\"]: return
		
	$\"../../TileMap/objects\".set_cell(Vector2i(3, 9), 1, Vector2i(9, 9))
	Sfx2.stream = load(\"res://assets/sound/sfx/door_close.mp3\")
	Sfx2.play()
"

[sub_resource type="RectangleShape2D" id="RectangleShape2D_uef7v"]
size = Vector2(32, 32)

[sub_resource type="GDScript" id="GDScript_6el3g"]
resource_name = "open_women_door"
script/source = "extends Area2D

func _on_body_entered(body: Node2D) -> void:
	if body.name not in [\"player\", \"PartyMemberBonnie\", \"PartyMemberChica\", \"PartyMemberFoxy\", \"PartyMemberGolden Freddy\"]: return
	
	await get_tree().create_timer(0.1).timeout
	for c in get_overlapping_bodies():
		if c.name in [\"PartyMemberBonnie\", \"PartyMemberChica\", \"PartyMemberFoxy\", \"PartyMemberGolden Freddy\"]: return
	
	for p in PlayerStats.party:
		if p.name == \"Bonnie\":
			$\"../../TileMap/objects\".set_cell(Vector2i(3, 3), 1, Vector2i(8, 10))
			Sfx2.stream = load(\"res://assets/sound/sfx/door_open.mp3\")
			Sfx2.play()
			
func _on_body_exited(body: Node2D) -> void:
	if body.name not in [\"player\", \"PartyMemberBonnie\", \"PartyMemberChica\", \"PartyMemberFoxy\", \"PartyMemberGolden Freddy\"]: return
	
	await get_tree().create_timer(0.1).timeout
	for c in get_overlapping_bodies():
		if c.name in [\"PartyMemberBonnie\", \"PartyMemberChica\", \"PartyMemberFoxy\", \"PartyMemberGolden Freddy\"]: return
	
	$\"../../TileMap/objects\".set_cell(Vector2i(3, 3), 1, Vector2i(9, 9))
	Sfx2.stream = load(\"res://assets/sound/sfx/door_close.mp3\")
	Sfx2.play()
"

[sub_resource type="GDScript" id="GDScript_6r2ks"]
resource_name = "open_toilet_door"
script/source = "extends Area2D

var tile_pos = Vector2i(0,0)

func _ready() -> void:
	tile_pos = $\"../../TileMap/objects\".local_to_map(position)

func _on_body_entered(body: Node2D) -> void:
	if body.name not in [\"player\", \"PartyMemberBonnie\", \"PartyMemberChica\", \"PartyMemberFoxy\", \"PartyMemberGolden Freddy\"]: return
	
	await get_tree().create_timer(0.1).timeout
	for c in get_overlapping_bodies():
		if c.name in [\"PartyMemberBonnie\", \"PartyMemberChica\", \"PartyMemberFoxy\", \"PartyMemberGolden Freddy\"]: return
		
	$\"../../TileMap/objects\".erase_cell(tile_pos)
	Sfx2.stream = load(\"res://assets/sound/sfx/door_open.mp3\")
	Sfx2.play()

func _on_body_exited(body: Node2D) -> void:
	if body.name not in [\"player\", \"PartyMemberBonnie\", \"PartyMemberChica\", \"PartyMemberFoxy\", \"PartyMemberGolden Freddy\"]: return
	
	await get_tree().create_timer(0.1).timeout
	for c in get_overlapping_bodies():
		if c.name in [\"PartyMemberBonnie\", \"PartyMemberChica\", \"PartyMemberFoxy\", \"PartyMemberGolden Freddy\"]: return
		
	$\"../../TileMap/objects\".set_cell(tile_pos, 1, Vector2i(8,3))
	Sfx2.stream = load(\"res://assets/sound/sfx/door_close.mp3\")
	Sfx2.play()
"


[sub_resource type="GDScript" id="GDScript_wtq0x"]
resource_name = "object_anim_helpers"
script/source = "extends TileMapLayer

func tp_toilets():
	erase_cell(Vector2i(4,1))
	erase_cell(Vector2i(6,1))
	erase_cell(Vector2i(10,1))
	set_cell(Vector2i(6,3), 1, Vector2i(10,0))
	set_cell(Vector2i(7,3), 1, Vector2i(10,0))
	set_cell(Vector2i(9,3), 1, Vector2i(10,0), 1)
"


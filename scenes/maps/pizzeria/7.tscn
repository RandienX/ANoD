[sub_resource type="GDScript" id="GDScript_uef7v"]
resource_name = "startup"
script/source = "extends AnimatedSprite2D

@export var party: String

func appear():
	for p in PlayerStats.party:
		if p.name == party:
			visible = true
			
func disappear():
	visible = false
"


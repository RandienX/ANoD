[sub_resource type="GDScript" id="GDScript_id31a"]
resource_name = "remove_coll"
script/source = "extends CollisionShape2D


# Called when the node enters the scene tree for the first time.
func _ready() -> void:
	if \"Pizzeria - Backstage\" in Global.scene_data.keys():
		disabled = true
		$TextboxMaker/CollisionShape2D.disabled = true
		$\"../..\".erase_cell(Vector2i(0, 1))
"


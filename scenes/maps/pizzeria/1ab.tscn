[sub_resource type="GDScript" id="GDScript_ytf3l"]
resource_name = "burnt_cove"
script/source = "extends TileMapLayer


func _ready() -> void:
	if \"burnt_cove\" in get_tree().current_scene.done_things.keys():
		visible = true
		$foxy.visible = false
"

